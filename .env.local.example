# ---------------------------------------------------------------------------
# Serafin Drones: Google Sheets credentials for the contact form
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored; never commit real credentials.
#
# How to get these values (full walkthrough in README.md):
#   1. In Google Cloud Console, create (or pick) a project.
#   2. APIs & Services → Library → enable the "Google Sheets API".
#   3. IAM & Admin → Service Accounts → Create service account.
#      Then open it → Keys → Add key → Create new key → JSON. A .json file downloads.
#   4. Create a Google Sheet, click Share, and add the service account's
#      email address as an **Editor**.
#   5. Copy the spreadsheet ID from its URL:
#      https://docs.google.com/spreadsheets/d/<THIS_PART_IS_THE_ID>/edit
# ---------------------------------------------------------------------------

# "client_email" from the downloaded JSON key file
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com

# "private_key" from the JSON key file. Keep it on ONE line, wrapped in double
# quotes, with line breaks written as \n (exactly as it appears in the JSON).
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"

# The long ID from the spreadsheet URL (between /d/ and /edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
